# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: alamat tempat aplikasi ini dilayani.
#
# WAJIB berupa URL absolut lengkap dengan http:// atau https://. Nilai
# non-absolut diperlakukan sebagai jalur RELATIF oleh res.redirect, sehingga
# pengguna yang kembali dari alur OAuth dilempar ke alamat yang tidak ada.
#
# Repo ini pernah menyimpan placeholder harfiah "MY_APP_URL" di sini. Ia lolos
# setiap pemeriksaan "kosong atau tidak" karena memang tidak kosong, tetapi
# sama sekali tidak berguna. `npm run doctor` kini menolaknya.
#
# Di production nilai ini juga menentukan daftar origin Socket.IO bila
# ALLOWED_ORIGINS tidak diisi.
APP_URL=http://localhost:3000

# PostgreSQL (Neon) Database Configuration
# Ganti dengan connection string Neon PostgreSQL Anda
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
POSTGRES_URL="postgresql://user:password@host/database?sslmode=require"

# Keamanan JWT (Rencana LanPro v1.3)
JWT_SECRET="ganti_dengan_rahasia_anda_yang_sangat_kuat"

# Optimasi Beban Concurrency & Connection Pooling (LanPro v1.5)
DB_CONNECTION_LIMIT="100"
DB_MAX_IDLE="50"

# ── Penyimpanan berkas ───────────────────────────────────────────────────────
# local = disk mesin (bawaan, cukup untuk pengembangan)
# s3    = object storage S3-kompatibel: AWS S3, Cloudflare R2, MinIO
#
# WAJIB diisi s3 untuk produksi. Pada platform serverless, disk bersifat
# sementara: setiap deploy memulai dari nol dan seluruh berkas unggahan hilang,
# sementara baris database tetap menunjuk berkas yang sudah tidak ada.
STORAGE_DRIVER=local

# Diisi hanya bila STORAGE_DRIVER=s3
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Endpoint khusus untuk R2/MinIO. Dikosongkan bila memakai AWS S3.
STORAGE_ENDPOINT=
# URL publik bucket, dipakai sebagai awalan URL berkas.
STORAGE_PUBLIC_URL=

# ── SSO Google / Microsoft (F5) ──────────────────────────────────────────────
# Provider yang dibiarkan KOSONG SELURUHNYA dianggap tidak dipakai dan
# tombolnya cukup disembunyikan. Yang TIDAK boleh adalah mengisi separuh:
# client id tanpa secret akan membuat server menolak menyala, karena itu
# berarti seseorang bermaksud menyalakannya tetapi belum selesai.
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=

OIDC_MICROSOFT_CLIENT_ID=
OIDC_MICROSOFT_CLIENT_SECRET=
# "common" menerima akun Microsoft mana pun. Isi dengan Tenant ID organisasi
# bila ingin membatasinya di sisi Microsoft juga.
OIDC_MICROSOFT_TENANT=common

# Harus SAMA PERSIS dengan yang didaftarkan di Google Cloud Console dan
# Azure Portal. Beda satu garis miring pun akan ditolak provider.
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback

# Domain email yang boleh memakai SSO, dipisah koma. WAJIB diisi:
# daftar kosong berarti MENOLAK SEMUA, bukan mengizinkan semua. Tanpa ini
# siapa pun ber-Gmail bisa mendaftar lewat tombol "Daftar dengan Google".
# Contoh: rajonet.com
SSO_ALLOWED_DOMAINS=rajonet.com

# Token untuk mengakses GET /metrics (Prometheus). Endpoint itu berada di luar
# /api/ sehingga gerbang autentikasi global tidak menyentuhnya, dan sebelum
# item #58 ia terbuka untuk umum.
#
# Kirim sebagai `Authorization: Bearer <token>` atau header `X-Metrik-Token`.
# Bila DIBIARKAN KOSONG, endpoint metrik DINONAKTIFKAN (jawaban 503) — bukan
# dibuka. Lupa mengisi tidak boleh berarti kembali terbuka untuk umum.
#
# Contoh membuat nilainya:  openssl rand -hex 32
METRIK_TOKEN=
